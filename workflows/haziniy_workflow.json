          },
          {
            "node": "Kanal uchun AI Tahlilchi",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Kanal uchun AI Tahlilchi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini (Private)": {
      "ai_languageModel": [
        [
          {
            "node": "Ota-onaga AI Javob Beruvchi",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Ota-onaga AI Javob Beruvchi": {
      "main": [
        [
          {
            "node": "Ota-onaga Telegramdan yuborish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini (Logger)": {
      "ai_languageModel": [
        [
          {
